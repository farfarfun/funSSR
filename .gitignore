# ---- farfarfun 组织约定 (SPEC §10) ----
# 服务脚本的运行时文件：日志 / PID / lock
.run/
logs/
*.log

# 本地数据库与压缩包不进版本管理，确需版本化走 Git LFS
*.db
*.sqlite
*.sqlite3
*.rar
*.7z

# 构建产物（无前导斜杠，任意层级都匹配，含 utools/dist/）
dist/
build/

# 浏览器重复下载产生的文件名（如 "xxx (1).zip"）—— 典型的误 git add 产物，
# 见 darkssr/client/ 下正经的客户端安装包命名（无括号），不要放宽到匹配所有 *.zip
* (*)*

# 编辑器 / IDE
.idea/
.vscode/
*.swp
.DS_Store

# 凭据：绝不提交
.env
.env.*
!.env.example
*.pem
*.key

# ---- AI 编码助手 ----
# 只忽略本地状态；团队有意共享的 agent / 命令 / 规则定义仍然版本化。
# 必须写 `dir/*` 而不是 `dir/`：父目录被整体排除后 git 不会下探，
# 下面的 `!` 取消规则就永远不会生效。
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/settings.json
.codex/*
!.codex/prompts/
.cursor/*
!.cursor/agents/
!.cursor/rules/

# 其余助手：目前没有共享内容，整体忽略
.aider*
.gemini/
.continue/
.windsurf/
.roo/
.cline/
.specstory/
CLAUDE.local.md
AGENTS.local.md
